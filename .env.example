# SatQuery AI — Environment Configuration
# Copy this file to .env and configure values

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload & Processing limits
MAX_UPLOAD_SIZE_MB=500
PREVIEW_MAX_SIZE=2048

# Database (PostgreSQL / PostGIS in Docker, SQLite fallback supported for standalone dev)
DATABASE_URL=postgresql+asyncpg://satquery:<YOUR_POSTGRES_PASSWORD>@localhost:5432/satquery_db
# For local dev without Postgres: sqlite+aiosqlite:///./satquery.db

# Storage (MinIO / S3-compatible, local disk fallback supported)
STORAGE_BACKEND=local
# Options: minio, local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=<YOUR_MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<YOUR_MINIO_SECRET_KEY>
MINIO_BUCKET=satquery-imagery
MINIO_SECURE=false

# Local Storage Directory (Used when STORAGE_BACKEND=local or as fallback)
LOCAL_STORAGE_PATH=./data/storage

